{
    "name": "mouseketeers/silverstripe-consent-forms",
    "description": "A SilverStripe module to handle user consents in forms",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "consent",
        "GDPR"
    ],
    "homepage": "https://github.com/Mouseketeers/silverstripe-consent-forms",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Henrik Olsen",
            "email": "henrik@mouseketeers.dk"
        }
    ],
    "support": {
        "issues": "https://github.com/Mouseketeers/silverstripe-consent-forms/issues",
        "source": "https://github.com/Mouseketeers/silverstripe-consent-forms"
    },
    "require": {
        "silverstripe/framework": "^4.0",
        "silverstripe/cms": "^4.0",
        "silverstripe/siteconfig": "^4.0",
        "silverstripe/userforms": "^5.0",
        "mouseketeers/silverstripe-consent-records": "^2.1"
    },
    "config": {
        "process-timeout": 600
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Mouseketeers\\ConsentForms\\": "src/"
        }
    }
}
