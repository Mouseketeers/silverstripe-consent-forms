{
    "name": "mouseketeers/silverstripe-consent-forms",
    "description": "A SilverStripe module to handle user consents in forms",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "consent",
        "GDPR"
    ],
    "homepage": "https://github.com/Mouseketeers/silverstripe-consent-forms",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Henrik Olsen",
            "email": "henrik@mouseketeers.dk"
        }
    ],
    "support": {
        "issues": "https://github.com/Mouseketeers/silverstripe-consent-forms/issues",
        "source": "https://github.com/Mouseketeers/silverstripe-consent-forms"
    },
    "require": {
        "silverstripe/framework": "^6",
        "silverstripe/siteconfig": "^6",
        "mouseketeers/silverstripe-consent-records": "^3",
        "php": "^8.3"
    },
    "suggest": {
        "mouseketeers/silverstripe-consent-userforms": "Adds UserForms integration: CMS-editable consent fields and automatic consent recording on submission"
    },
    "config": {
        "process-timeout": 600
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Mouseketeers\\ConsentForms\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "silverstripe/sqlite3": "^4"
    },
    "autoload-dev": {
        "psr-4": {
            "Mouseketeers\\ConsentForms\\Tests\\": "tests/"
        }
    }
}
